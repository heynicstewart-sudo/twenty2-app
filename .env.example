# Copy this file to .env and fill in real values to run the app locally
# (npm start). .env is git-ignored - nothing here ever gets committed or
# deployed. Railway keeps its own copies of these as config vars; this file
# never needs to match it exactly.
#
# Leaving AGENCY_CONTROL_BASE_ID unset (or blank) runs a single-tenant
# Twenty2-only copy of the app, matching what's deployed on Railway.
# Filling it in unlocks the full local "agency" experience: the client
# switcher, the Agency Dashboard (tasks, time tracking, billing across all
# your clients), and the Marketing tab's content-generation tools (Draft
# Centre, SEO, AEO, Email, Google Ads drafting) - none of which the
# deployed, client-facing site shows.

# Required for any Airtable-backed route to work at all.
AIRTABLE_API_KEY=

# Twenty2 Collective's own base - used directly whenever there's no
# control-plane base (see below), and by the control-plane fallback too.
AIRTABLE_BASE_ID=

# Set this to run the full local agency install (client switcher + Agency
# Dashboard + content generation). Leave blank to mirror the locked,
# Twenty2-only deployed site instead.
AGENCY_CONTROL_BASE_ID=

# Needed for anything that calls the Engine (content drafts, message
# generation, SEO/AEO posts, email copy, etc).
ANTHROPIC_API_KEY=

# Leave both blank locally - only needed to password-protect the deployed
# Railway URL.
RAILWAY_BASIC_AUTH_USER=
RAILWAY_BASIC_AUTH_PASS=
